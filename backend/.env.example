# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
SYNC_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Cloudflare R2 (S3-compatible object storage) — tour/property/profile images
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ovigo
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com
