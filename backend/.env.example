# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
SYNC_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# false for a same-network self-hosted Postgres with no TLS cert configured (e.g. the
# Dokploy-internal database); true (the default) for a provider that requires TLS, e.g. Neon.
DB_SSL_REQUIRED=true

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# Cloudflare R2 (S3-compatible object storage) — tour/property/profile images
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ovigo
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# SSLCommerz (payment gateway) — sandbox credentials from https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=your-sandbox-store-id
SSLCOMMERZ_STORE_PASSWD=your-sandbox-store-password
SSLCOMMERZ_IS_LIVE=false

# Triptel Partner Reseller API (Phase 5: eSIM store) — see TRIPTEL_PARTNER_API.md.
# Leave TRIPTEL_API_KEY unset to boot with the eSIM store simply unavailable (every
# eSIM endpoint returns 503) — no other functionality is affected.
TRIPTEL_API_BASE_URL=https://triptel.co/api/v1/partner
TRIPTEL_API_KEY=
TRIPTEL_WEBHOOK_SECRET=
